ource":"Z","assumption":null},"rear_ft":{"value":0.0,"source":"Z","assumption":null}},"max_height_ft":null,"max_stories":{"value":0.0,"source":"Z","assumption":"Not relevant: homes not counted."},"lot_coverage":null,"max_floor_area":null,"max_far":null,"max_buildable_multiple":null,"min_open_space_share":null,"parking_per_unit":null,"guest_parking_per_unit":null,"guest_parking_min_units":null,"sb9_allowed":null,"simplifications":[]},"R-1":{"zone":"R-1","name":"Single-Family Residential (R-1)","family":"single_family","sources":{"Z":{"section":"AMC \u00a7\u00a79-2.2802 and 9-2.2805","url":"https://ecode360.com/43221346"}},"residential_allowed":{"value":true,"source":"Z","assumption":null},"housing_types":{"value":["single_family"],"source":"Z","assumption":null},"min_lot_area_sqft":{"value":6000.0,"source":"Z","assumption":"Used where no number follows the zone. SCAG drops any number."},"min_lot_width_ft":{"value":50.0,"source":"Z","assumption":null},"max_units_per_lot":{"value":1,"source":"Z","assumption":"One home per lot (\u00a79-2.2805(a)(2)). State law (ADU, SB 9) is modeled separately."},"lot_area_per_unit_sqft":null,"units_per_acre":null,"small_lot_units":null,"small_lot_units_below_sqft":null,"density_rounding":null,"setbacks":{"front_ft":{"value":20.0,"source":"Z","assumption":null},"side_ft":{"value":{"pct_of_width":0.1,"min_ft":3.0,"max_ft":5.0},"source":"Z","assumption":null},"rear_ft":{"value":5.0,"source":"Z","assumption":null}},"max_height_ft":{"value":30.0,"source":"Z","assumption":null},"max_stories":{"value":2.0,"source":"Z","assumption":null},"lot_coverage":{"value":0.5,"source":"Z","assumption":null},"max_floor_area":null,"max_far":null,"max_buildable_multiple":null,"min_open_space_share":null,"parking_per_unit":null,"guest_parking_per_unit":null,"guest_parking_min_units":null,"sb9_allowed":null,"simplifications":["Garage parking isn't modeled; the one-home limit binds."]}},"state":{"state":"CA","as_of":"2026-10-28","laws":[{"id":"adu","name":"Accessory Dwelling Units and Junior ADUs","status":"modeled","summary":"On a lot with (or proposed for) one single-family home, the state allows one ADU plus one junior ADU (inside the house), whatever local density says. Pasadena allows ADUs in all residential zones and in CO/CL (PMC Tables 2-2 and 2-5, \u00a717.50.275).","citation":{"section":"Cal. Gov. Code \u00a7\u00a766314-66342 (recodified from \u00a765852.2 by SB 477, effective 2025)","url":"https://leginfo.legislature.ca.gov/faces/codes_displayText.xhtml?lawCode=GOV&division=1.&title=7.&part=&chapter=13.&article=2."},"assumptions":["Applied wherever local zoning fits at least one home: the owner may build a house plus an ADU and a junior ADU instead of what local density allows. It's an alternative path (the larger of the two counts), not added on top.","Multifamily lots can also add ADUs under state law (conversions of non-living space and up to 8 detached ADUs, SB 1211). Not modeled yet, so multifamily ADU capacity is undercounted."],"params":{"units_added_to_single_family":2,"applies_to_families":["single_family","multifamily","commercial"]}},{"id":"sb9","name":"SB 9 two-unit developments and urban lot splits","status":"modeled","summary":"In single-family zones, the state allows two homes on a lot by right, and a one-time split of the lot into two, each allowed two homes: four in total. Pasadena adopted this as \"Two-Unit Developments\" (Table 2-2 note 5) and allows no ADUs on lots created by an urban lot split.","citation":{"section":"Cal. Gov. Code \u00a765852.21 (two-unit developments) and \u00a766411.7 (urban lot splits)","url":"https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=GOV&sectionNum=65852.21"},"assumptions":["Each new lot must also be at least 40% of the original; splitting a lot in half always satisfies that, so we don't check it.","SB 9 doesn't apply where the work would demolish rent-restricted housing or housing rented in the last 3 years. We don't have tenancy data, so this is not checked; capacity on rented lots is overstated.","Lots in very high fire hazard zones can still use SB 9 if they meet fire mitigation standards, so they are not excluded.","The owner-occupancy affidavit required for lot splits is a condition of approval, not a capacity limit.","Lots under 1,200 sq ft get no SB 9 units (they are almost all strips and slivers, not house lots)."],"params":{"applies_to_families":["single_family"],"units_without_split":2,"units_with_split":4,"min_lot_sqft_for_split":2400,"min_lot_sqft_for_two_units":1200,"excluded_overlay_prefixes":["LD-","HPOZ"]}},{"id":"ab2097","name":"AB 2097 no parking minimums near major transit","status":"modeled","summary":"Cities may not require any minimum parking for housing within \u00bd mile of a major transit stop (Public Resources Code \u00a721064.3).","citation":{"section":"Cal. Gov. Code \u00a765863.2","url":"https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=GOV&sectionNum=65863.2"},"assumptions":["Distance is measured from the nearest edge of the lot, i.e. a lot counts if any part of it is within \u00bd mile. Measuring from the lot's center would cover fewer lots.","Major transit stops come from SCAG's 2022 base-year inventory, which uses the AB 2553 definition (20-minute peak headways)."],"params":{"radius_ft":2640}},{"id":"sb79","name":"SB 79 transit-oriented development upzoning (2025)","status":"not_modeled","summary":"Allows taller, denser housing near high-frequency rail and bus rapid transit stops. Its height and density tiers, effective date, and local alternative-plan options need to be checked before modeling; until then, capacity near Metro A Line stations is UNDERESTIMATED.","citation":{"section":"Senate Bill 79 (2025-2026 session)","url":"https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260SB79"},"assumptions":[],"params":{}},{"id":"density_bonus","name":"State Density Bonus Law","status":"not_modeled","summary":"Projects that include affordable units can exceed local density (often by 50% or more) and waive some standards. It depends on a project's affordability mix, so it's not part of base capacity; it could become a scenario lever.","citation":{"section":"Cal. Gov. Code \u00a765915","url":"https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=GOV&sectionNum=65915"},"assumptions":[],"params":{}}]},"assumptions":{"gross_sqft_per_unit":1062.5,"parking_stall_sqft":300.0,"min_home_sqft":500.0},"redevelopment":{"as_of_year":2026,"min_capacity_multiple":2.0,"min_net_new_units":3,"min_building_age_years":50,"max_improvement_to_land_ratio":1.0,"exclude_condos":true,"exclude_overlay_prefixes":[],"exclude_single_family_zones":true}}